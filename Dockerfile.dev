# Development image for the Rails API. The production image remains in Dockerfile.
ARG RUBY_VERSION=3.4.11
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential libpq-dev libvips libyaml-dev postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

# Windows checkouts may use CRLF line endings and Windows Ruby shebangs.
RUN chmod +x bin/* && \
    sed -i 's/\r$//g' bin/* && \
    sed -i 's/ruby\.exe$/ruby/' bin/*

EXPOSE 3000

# Intentionally bypass bin/docker-entrypoint, which automatically runs db:prepare.
CMD ["ruby", "./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
